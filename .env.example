# ─────────────────────────────────────────────────────────────────────────────
# Nia — environment variables
# Copy to .env (repo root) and fill in. Never commit real values.
# Everything is read server-side only; nothing here is exposed to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the web app (used for links, Telegram webhook, same-origin checks).
# Local: http://localhost:3210 (pnpm dev) · Production: https://your-domain.com
APP_URL=http://localhost:3210

# PostgreSQL. Local zero-install server: `pnpm dev:db` → the URL below.
# Production: Neon / Supabase / any Postgres 15+ (use the pooled connection string).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/nia

# 32+ random characters (e.g. `openssl rand -base64 48`). Signs sign-in codes.
AUTH_SECRET=

# ── AI model (use a non-OpenAI/non-Anthropic model for “Beyond the Big Two”) ──
# AI_PROVIDER: groq | google | mistral | deepseek | openai-compatible
AI_PROVIDER=groq
# Groq: qwen/qwen3.8-27b (Alibaba Qwen; tool calling + JSON-schema output). Models available to your key:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer <AI_API_KEY>"
# Google: gemini-flash-latest · Mistral: mistral-large-latest · DeepSeek: deepseek-chat
AI_MODEL=qwen/qwen3.8-27b
# Optional cheaper model for the structured memory-extraction step (defaults to AI_MODEL).
AI_EXTRACTION_MODEL=
# Groq: https://console.groq.com/keys · Google AI Studio: https://aistudio.google.com/apikey
# Groq's free tier allows ~8,000 tokens/min per model and one Nia turn uses ~4,500–5,500
# (reply + memory extraction), so a second message within a minute waits. Fine for solo
# testing; switch to Groq's paid Developer tier before inviting real users.
AI_API_KEY=
# Only for AI_PROVIDER=openai-compatible (e.g. https://dashscope-intl.aliyuncs.com/compatible-mode/v1 or https://openrouter.ai/api/v1)
AI_BASE_URL=

# ── Walrus Memory (Mainnet) — https://memory.walrus.xyz ──
# Create an account + DELEGATE key on the dashboard. Never use the owner wallet key here.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Namespace prefix. Use "nia" in production and something else (e.g. "nia-dev") locally.
MEMWAL_NAMESPACE_PREFIX=nia
# Cost ceiling: durable memory writes per namespace per hour.
MEMWAL_MAX_WRITES_PER_HOUR=30
# Cosine-distance cutoff for recall (lower = stricter). 0.8 is a good default.
MEMWAL_RECALL_MAX_DISTANCE=0.8
# The relayer allows 60 weighted requests/min per delegate key, shared by every customer of
# this deployment. Job-status checks are batched and shared by all pollers at most this often (ms).
MEMWAL_STATUS_MIN_INTERVAL_MS=5000

# ── Telegram — create a bot with @BotFather. Enables "Continue with Telegram" sign-in and the bot. ──
TELEGRAM_BOT_TOKEN=
# 16–256 chars of A-Z a-z 0-9 _ - (Telegram echoes it in X-Telegram-Bot-Api-Secret-Token).
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# The bot's username: nia_bot, @nia_bot or https://t.me/nia_bot all work.
TELEGRAM_BOT_USERNAME=
# Optional: shop slug new Telegram chats talk to before choosing one.
TELEGRAM_DEFAULT_SHOP=

# ── Email sign-in codes (required in production) — https://resend.com ──
RESEND_API_KEY=
EMAIL_FROM=Nia <login@your-domain.com>

# ── Payments (optional) — Paystack hosted checkout ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Enables Judge Mode (before/after comparison + proof panel) for shop owners.
NIA_DEMO_MODE=true
# Development only: print sign-in codes in the server console when Resend isn't set.
NIA_DEV_LOG_CODES=true

# `pnpm db:seed`: make this account the OWNER of the fictional demo stores.
SEED_OWNER_EMAIL=
# Optional: your numeric Telegram user id, to own the demo stores when you sign in with Telegram.
SEED_OWNER_TELEGRAM_ID=

# Optional: better-matched product photos for `pnpm market:images -- --provider pexels` (https://www.pexels.com/api/)
PEXELS_API_KEY=
